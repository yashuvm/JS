function arySortRemoveDup(st) {
let ary = st.split(",")
//sort ary
sortAry(ary)
//console.log(newAry1)
//now remove duplication
let newAry=[]
for(let value of ary){
if(newAry.indexOf(value)===-1){
newAry.push(value)
}
}
//console.log(newAry)
const newEl=newAry.join(",")
return newEl
}

function sortAry(ary) {
for (let i = 0; i <= ary.length - 1; i++) {
let minIndex = i
for (let j = i + 1; j <= ary.length - 1; j++) {
if (parseInt(ary[j]) < parseInt(ary[minIndex])) {
minIndex = j
}
}
//swap
const tmp=ary[i]
ary[i]=ary[minIndex]
ary[minIndex]=tmp
}
return ary
}

console.log(arySortRemoveDup("1,2,22,576,4,7,2,22,98,34"))

